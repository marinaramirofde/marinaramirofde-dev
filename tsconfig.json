{
    "extends":  "astro/tsconfigs/strict",
    "compilerOptions":  {
                            "baseUrl":  ".",
                            "paths":  {
                                          "@components/*":  [
                                                                "src/components/*"
                                                            ],
                                          "@config/*":  [
                                                            "src/config/*"
                                                        ],
                                          "@data/*":  [
                                                          "src/data/*"
                                                      ],
                                          "@i18n/*":  [
                                                          "src/i18n/*"
                                                      ],
                                          "@layouts/*":  [
                                                             "src/layouts/*"
                                                         ],
                                          "@styles/*":  [
                                                            "src/styles/*"
                                                        ],
                                          "@types/*":  [
                                                           "src/types/*"
                                                       ]
                                      }
                        },
    "exclude":  [
                    "dist",
                    "node_modules"
                ]
}
