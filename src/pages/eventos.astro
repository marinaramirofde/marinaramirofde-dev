---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/layout/PageHeading.astro";
import { getDictionary } from "../i18n";
import { portfolioConfig } from "../config/portfolio.config";
import { eventProfiles } from "../data/events";
import TechIcon from "../components/home/TechIcon.astro";
const t = getDictionary(portfolioConfig.defaultLocale);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<BaseLayout title={`${t.events.title} · ${portfolioConfig.brandName}`} description={t.events.text}>
  <div class="news-page">
    <PageHeading eyebrow={t.events.newsroom} title={t.events.title} description={t.events.text} eyebrowKey="events.newsroom" titleKey="events.title" descriptionKey="events.text" />
    <section aria-labelledby="news-latest">
      <h2 class="news-section-title" id="news-latest" data-i18n="events.latest">{t.events.latest}</h2>
      <div class="news-grid">
        {eventProfiles.map((event, index) => {
          const item = t.events.items[index];
          return <article class="news-card">
            <a class="news-card__image" href={`${base}eventos/${event.slug}`} aria-labelledby={`news-title-${index}`}>
              <img src={`${base}${event.image}`} alt="" width="720" height="480" loading={index < 3 ? "eager" : "lazy"} decoding="async" />
            </a>
            <div class="news-card__body">
              <p class="news-card__category" data-i18n={`events.items.${index}.0`}>{item[0]}</p>
              <h3 id={`news-title-${index}`}><a href={`${base}eventos/${event.slug}`} data-i18n={`events.items.${index}.1`}>{item[1]}</a></h3>
              <p class="news-card__description" data-i18n={`events.items.${index}.2`}>{item[2]}</p>
              <a class="news-card__more" href={`${base}eventos/${event.slug}`} aria-labelledby={`news-read-${index} news-title-${index}`}><span id={`news-read-${index}`} data-i18n="events.readMore">{t.events.readMore}</span><TechIcon kind="next" /></a>
            </div>
          </article>;
        })}
      </div>
    </section>
    <footer class="news-footer"><p data-i18n="events.closing">{t.events.closing}</p><a href={`${base}contacto`}><span data-i18n="events.contact">{t.events.contact}</span><TechIcon kind="chat" /></a></footer>
  </div>
</BaseLayout>
<style>
  .news-page { --news-ink: #363e4f; --news-muted: #535d68; --news-accent: #285e70; max-width: 1224px; margin-inline: auto; padding: clamp(100px, 10vw, 144px) 32px 80px; font-family: "Manrope", system-ui, sans-serif; color: var(--news-ink); }
  .news-section-title { font-family: inherit; font-size: 1.1rem; margin: 0 0 24px; letter-spacing: -.02em; }
  .news-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px 28px; }
  .news-card { min-width: 0; display: flex; flex-direction: column; border-bottom: 1px solid #d9dfe3; padding-bottom: 24px; }
  .news-card__image { display: block; aspect-ratio: 3 / 2; overflow: hidden; border-radius: 10px; background: #e7f1f4; }
  .news-card__image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .news-card__body { display: flex; flex-direction: column; flex: 1; padding-top: 20px; }
  .news-card__category { font-size: .78rem; font-weight: 700; color: var(--news-accent); line-height: 1.5; margin: 0 0 10px; }
  .news-card h3 { font-family: inherit; font-size: 1.45rem; letter-spacing: -.025em; line-height: 1.35; margin: 0; text-wrap: balance; }
  .news-card a { text-decoration: none; color: inherit; }
  .news-card__description { color: var(--news-muted); line-height: 1.75; font-size: .95rem; margin: 14px 0 20px; }
  .news-card .news-card__more { display: inline-flex; align-items: center; align-self: flex-start; gap: 12px; min-height: 44px; font-weight: 700; font-size: .9rem; color: var(--news-accent); margin-top: auto; }
  .news-page :global(.clean-tech-icon) { width: 20px; height: 20px; flex-shrink: 0; }
  .news-page a:hover { color: #163f50; text-decoration: underline; text-underline-offset: 4px; }
  .news-page a:focus-visible { outline: 3px solid var(--news-accent); outline-offset: 5px; border-radius: 3px; }
  .news-footer { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 24px; margin-top: 64px; padding: 28px; border-radius: 10px; background: #e7f1f4; }
  .news-footer p { max-width: 630px; margin: 0; line-height: 1.75; }
  .news-footer a { display: inline-flex; align-items: center; gap: 12px; min-height: 44px; color: var(--news-accent); font-weight: 700; text-decoration: none; }
  @media(max-width: 960px) { .news-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media(max-width: 600px) { .news-page { padding-inline: 20px; } .news-grid { grid-template-columns: 1fr; gap: 32px; } .news-heading { margin-bottom: 36px; } .news-footer { padding: 24px; } }
</style>
