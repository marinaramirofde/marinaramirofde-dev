---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeading from "../components/layout/PageHeading.astro";
import { getDictionary } from "../i18n";
import { portfolioConfig } from "../config/portfolio.config";
const t = getDictionary(portfolioConfig.defaultLocale);
---
<BaseLayout title={`Charlas · ${portfolioConfig.brandName}`}>
  <article class="content-page page-heading-host">
    <PageHeading eyebrow={t.pages.talksEyebrow} title={t.talks.title} description={t.talks.text} eyebrowKey="pages.talksEyebrow" titleKey="talks.title" descriptionKey="talks.text" />
    <div class="content-page__visual content-page__visual--line" aria-hidden="true" data-reveal>{t.pages.talkWords.map((word: string, index: number) => <span data-i18n={`pages.talkWords.${index}`}>{word}</span>)}<i></i></div>
  </article>
</BaseLayout>