---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { portfolioConfig } from "../../config/portfolio.config";
import { projects } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      previousProject: projects[(index - 1 + projects.length) % projects.length],
      nextProject: projects[(index + 1) % projects.length]
    }
  }));
}

const { project, previousProject, nextProject } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={`${project.title} · ${portfolioConfig.brandName}`} description={project.summary}>
  <article class={`case-study case-study--${project.accent}`}>
    <header class="case-study__hero" data-reveal>
      <a class="case-study__back" href={`${basePath}proyectos`}><span aria-hidden="true">←</span> Todos los proyectos</a>
      <div class="case-study__heading">
        <p class="eyebrow">{project.category} / {project.code}</p>
        <h1>{project.title}</h1>
        <p class="case-study__description">{project.description}</p>
        {project.externalUrl && (
          <a class="case-study__external" href={project.externalUrl} target="_blank" rel="noreferrer">
            Visitar web oficial <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </header>

    <figure class="case-study__cover" data-reveal>
      <img src={`${basePath}${project.coverImage.slice(1)}`} alt={`Ilustración de presentación de ${project.title}`} width="1600" height="900" />
      <figcaption><span>{project.code}</span><span>{project.status}</span></figcaption>
    </figure>

    <section class="case-study__overview" aria-labelledby="project-overview-title">
      <div class="case-study__intro" data-reveal>
        <p class="eyebrow">Portfolio / Caso de estudio</p>
        <h2 id="project-overview-title">El proyecto</h2>
        <p>{project.summary}</p>
      </div>
      <dl class="case-study__meta" data-reveal>
        <div><dt>Mi función</dt><dd>{project.role}</dd></div>
        <div><dt>Tecnologías</dt><dd>{project.technologies.join(" · ")}</dd></div>
        <div><dt>Cliente</dt><dd>{project.client}</dd></div>
        <div><dt>Socios</dt><dd>{project.partners}</dd></div>
        <div><dt>Estado</dt><dd>{project.status}</dd></div>
      </dl>
    </section>

    <section class="case-study__facts" aria-label="Desarrollo del caso de estudio">
      <article data-reveal><span>01</span><h2>Caso de uso</h2><p>{project.useCase}</p></article>
      <article data-reveal><span>02</span><h2>Objetivo</h2><p>{project.objective}</p></article>
      <article data-reveal><span>03</span><h2>Resultado</h2><p>{project.outcome}</p></article>
    </section>

    <section class="case-study__gallery" aria-labelledby="project-gallery-title">
      <header data-reveal>
        <p class="case-study__gallery-label">Galería técnica / Evidencias visuales</p>
        <h2 id="project-gallery-title">Documentación visual del proyecto</h2>
        <p class="case-study__gallery-intro">Collage técnico de escenas, interfaces y pruebas de interacción. Las imágenes conceptuales se sustituirán por documentación real del proyecto.</p>
      </header>
      <div data-gallery-count={project.gallery.length}>
        {project.gallery.map((image, index) => (
          <figure data-reveal style={`--reveal-delay: ${index * 80}ms`}>
            <img src={`${basePath}${image.src.slice(1)}`} alt={image.alt} loading="lazy" decoding="async" width="1600" height="1000" />
            <figcaption><span>0{index + 1}</span>{image.caption}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <nav class="case-study__navigation" aria-label="Navegación entre proyectos" data-reveal>
      <a href={`${basePath}proyectos/${previousProject.slug}`}><small>Anterior</small><strong>← {previousProject.title}</strong></a>
      <a href={`${basePath}proyectos/${nextProject.slug}`}><small>Siguiente</small><strong>{nextProject.title} →</strong></a>
    </nav>
  </article>
</BaseLayout>
