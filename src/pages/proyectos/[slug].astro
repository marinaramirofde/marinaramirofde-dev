---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { portfolioConfig } from "../../config/portfolio.config";
import { getDictionary } from "../../i18n";

export function getStaticPaths() {
  const projectEntries = [
    { slug: "xr-medical-viewer", code: "XR-01", title: "XR Medical Viewer", summary: "Base para documentar un visor médico inmersivo con Three.js, WebXR y arquitectura estática.", stack: "Three.js / WebXR / Salud" },
    { slug: "ar-research-prototype", code: "AR-02", title: "AR Research Prototype", summary: "Base para documentar prototipos de realidad aumentada aplicados a investigación y visualización.", stack: "Unity / C# / AR" },
    { slug: "immersive-education-lab", code: "VR-03", title: "Immersive Education Lab", summary: "Base para documentar experiencias educativas inmersivas, talleres y comunidad.", stack: "XR / UX / Comunidad" }
  ];
  return projectEntries.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const t = getDictionary(portfolioConfig.defaultLocale);
---

<BaseLayout title={project.title + " · " + portfolioConfig.brandName} description={project.summary}>
  <article class="content-page content-page--wide">
    <header class="content-page__hero" data-reveal>
      <p class="eyebrow"><span data-i18n="pages.caseStudy">{t.pages.caseStudy}</span> / {project.code}</p>
      <h1>{project.title}</h1><p>{project.summary}</p>
    </header>
    <div class="case-visual" aria-hidden="true" data-reveal><span>{project.code}</span><i></i></div>
    <div class="case-meta" data-reveal>
      <div><span data-i18n="pages.discipline">{t.pages.discipline}</span><strong data-i18n="pages.immersive">{t.pages.immersive}</strong></div>
      <div><span data-i18n="pages.stack">{t.pages.stack}</span><strong>{project.stack}</strong></div>
      <div><span data-i18n="pages.status">{t.pages.status}</span><strong data-i18n="pages.documentation">{t.pages.documentation}</strong></div>
    </div>
  </article>
</BaseLayout>