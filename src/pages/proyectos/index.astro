---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDictionary } from "../../i18n";
import { portfolioConfig } from "../../config/portfolio.config";
const t = getDictionary(portfolioConfig.defaultLocale);
const projects = [
  { title: "XR Medical Viewer", slug: "xr-medical-viewer", code: "XR-01", accent: "blue" },
  { title: "AR Research Prototype", slug: "ar-research-prototype", code: "AR-02", accent: "orange" },
  { title: "Immersive Education Lab", slug: "immersive-education-lab", code: "VR-03", accent: "rose" }
];
---

<BaseLayout title={`Proyectos · ${portfolioConfig.brandName}`}>
  <article class="content-page content-page--wide">
    <header class="content-page__hero" data-reveal>
      <p class="eyebrow">Selected work / Portfolio</p>
      <h1 data-i18n="projects.title">{t.projects.title}</h1>
      <p data-i18n="projects.text">{t.projects.text}</p>
    </header>
    <div class="card-grid">
      {projects.map((project, index) => (
        <article class={`project-card project-card--${project.accent}`} data-reveal style={`--reveal-delay: ${index * 80}ms`}>
          <a class="project-card__media" href={`/proyectos/${project.slug}`} aria-label={project.title}>
            <span class="project-card__code">{project.code}</span>
            <span class="project-card__shape" aria-hidden="true"></span>
            <span class="project-card__arrow" aria-hidden="true">↗</span>
          </a>
          <div class="project-card__body"><h2>{project.title}</h2><p>Case study</p></div>
        </article>
      ))}
    </div>
  </article>
</BaseLayout>