---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDictionary } from "../../i18n";
import { portfolioConfig } from "../../config/portfolio.config";
import { projects } from "../../data/projects";
const t = getDictionary(portfolioConfig.defaultLocale);
const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={`Proyectos · ${portfolioConfig.brandName}`}>
  <article class="projects-portfolio">
    <header class="projects-portfolio__header" data-reveal>
      <p class="eyebrow" data-i18n="pages.selectedWork">{t.pages.selectedWork}</p>
      <h1 data-i18n="projects.title">{t.projects.title}</h1>
      <p data-i18n="projects.text">{t.projects.text}</p>
    </header>

    <div class="project-portfolio-grid" aria-label="Casos de estudio">
      {projects.map((project, index) => (
        <a
          class={`project-tile project-tile--${project.accent}`}
          href={`${basePath}proyectos/${project.slug}`}
          aria-label={`Ver caso de estudio: ${project.title}`}
          data-reveal
          style={`--reveal-delay: ${index * 65}ms; --project-image: url('${basePath}${project.coverImage.slice(1)}')`}
        >
          <span class="project-tile__image" aria-hidden="true"></span>
          <span class="project-tile__index" aria-hidden="true">{project.code}</span>
          <span class="project-tile__center">
            <small>{project.category}</small>
            <strong>{project.title}</strong>
          </span>
          <span class="project-tile__hover">
            <span>{project.summary}</span>
            <small>{project.stack}</small>
            <b>Ver proyecto <i aria-hidden="true">↗</i></b>
          </span>
        </a>
      ))}
    </div>
  </article>
</BaseLayout>
