---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDictionary } from "../../i18n";
import { portfolioConfig } from "../../config/portfolio.config";
import { projects } from "../../data/projects";
import { isSectionExampleSelected } from "../../config/section-library.config";
import ProjectPerspectiveCarousel from "../../components/sections/examples/ProjectPerspectiveCarousel.astro";
const t = getDictionary(portfolioConfig.defaultLocale);
const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const usePerspectiveCarousel = isSectionExampleSelected("projects", "projects-perspective-carousel");
---

<BaseLayout title={`Proyectos · ${portfolioConfig.brandName}`}>
  {usePerspectiveCarousel ? <ProjectPerspectiveCarousel /> : (
  <article class="content-page content-page--wide">
    <header class="content-page__hero" data-reveal>
      <p class="eyebrow" data-i18n="pages.selectedWork">{t.pages.selectedWork}</p>
      <h1 data-i18n="projects.title">{t.projects.title}</h1><p data-i18n="projects.text">{t.projects.text}</p>
    </header>
    <div class="card-grid">
      {projects.map((project, index) => (
        <article class={`project-card project-card--${project.accent}`} data-reveal style={`--reveal-delay: ${index * 80}ms`}>
          <a class="project-card__media" href={`${basePath}proyectos/${project.slug}`} aria-label={project.title}>
            <span class="project-card__code">{project.code}</span><span class="project-card__shape" aria-hidden="true"></span><span class="project-card__arrow" aria-hidden="true">↗</span>
          </a>
          <div class="project-card__body"><h2>{project.title}</h2><p data-i18n="pages.caseStudy">{t.pages.caseStudy}</p></div>
        </article>
      ))}
    </div>
  </article>
  )}
</BaseLayout>
