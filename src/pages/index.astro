---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDictionary } from "../i18n";
import { portfolioConfig } from "../config/portfolio.config";
import Hero from "../components/sections/Hero.astro";
import Dashboard from "../components/sections/Dashboard.astro";
import HomeHighlights from "../components/sections/HomeHighlights.astro";
import Technologies from "../components/sections/Technologies.astro";

const t = getDictionary(portfolioConfig.defaultLocale);
const homeRegistry = {
  hero: Hero,
  dashboard: Dashboard,
  technologies: Technologies,
  "home-highlights": HomeHighlights
};
const homeSections = portfolioConfig.sections
  .filter((section) => section.enabled && section.id in homeRegistry)
  .sort((a, b) => a.order - b.order)
  .map((section) => homeRegistry[section.id as keyof typeof homeRegistry]);
---

<BaseLayout>
  {homeSections.map((Section) => <Section t={t} />)}
</BaseLayout>
