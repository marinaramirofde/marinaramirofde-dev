---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDictionary } from "../i18n";
import { portfolioConfig } from "../config/portfolio.config";
import Welcome from "../components/home/Welcome.astro";
import TechStack from "../components/home/TechStack.astro";
import About from "../components/home/About.astro";
import Experience from "../components/home/Experience.astro";
import Education from "../components/home/Education.astro";
import Training from "../components/home/Training.astro";
import FeaturedProjects from "../components/home/FeaturedProjects.astro";
import "../styles/selected-home.css";

const t = getDictionary(portfolioConfig.defaultLocale).selectedHome;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout>
  <div class="clean-home">
    <Welcome t={t} base={base} />
    <TechStack t={t} base={base} />
    <About t={t} />
    <Experience t={t} />
    <Education t={t} base={base} />
    <Training t={t} base={base} />
    <FeaturedProjects t={t} base={base} />
  </div>
</BaseLayout>
