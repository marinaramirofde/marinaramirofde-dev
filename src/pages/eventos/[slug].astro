---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { portfolioConfig } from "../../config/portfolio.config";
import { eventProfiles } from "../../data/events";
import { getDictionary } from "../../i18n";

export function getStaticPaths() {
  return eventProfiles.map((event, index) => ({
    params: { slug: event.slug },
    props: {
      event,
      eventIndex: index,
      previousEvent: eventProfiles[(index - 1 + eventProfiles.length) % eventProfiles.length],
      previousIndex: (index - 1 + eventProfiles.length) % eventProfiles.length,
      nextEvent: eventProfiles[(index + 1) % eventProfiles.length],
      nextIndex: (index + 1) % eventProfiles.length
    }
  }));
}

const { event, eventIndex, previousEvent, previousIndex, nextEvent, nextIndex } = Astro.props;
const t = getDictionary(portfolioConfig.defaultLocale);
const item = t.events.items[eventIndex];
const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<BaseLayout title={`${item[1]} · ${portfolioConfig.brandName}`} description={item[2]}>
  <article class="event-article">
    <header class="event-article__header" data-reveal>
      <a class="event-article__back" href={`${basePath}eventos`}>
        <span aria-hidden="true">←</span><span data-i18n="events.article.back">{t.events.article.back}</span>
      </a>
      <div class="event-article__title">
        <p data-i18n={`events.items.${eventIndex}.0`}>{item[0]}</p>
        <h1 data-i18n={`events.items.${eventIndex}.1`}>{item[1]}</h1>
        <strong data-i18n={`events.items.${eventIndex}.2`}>{item[2]}</strong>
      </div>
      <div class="event-article__stamp" aria-hidden="true">
        <span>{event.period}</span><i></i><small>XR</small>
      </div>
    </header>

    <figure class="event-article__cover" data-reveal>
      <img src={`${basePath}${event.image}`} alt={event.alt} loading="eager" />
      <figcaption><span data-i18n="events.article.story">{t.events.article.story}</span><b>{String(eventIndex + 1).padStart(2, "0")}</b></figcaption>
    </figure>

    <div class="event-article__content">
      <section class="event-article__story" aria-labelledby="event-story-title" data-reveal>
        <p class="event-article__label" data-i18n="events.article.story">{t.events.article.story}</p>
        <h2 id="event-story-title" data-i18n="events.article.about">{t.events.article.about}</h2>
        <p class="event-article__lead" data-i18n={`events.items.${eventIndex}.2`}>{item[2]}</p>
        <p data-i18n="events.article.body">{t.events.article.body}</p>
        <aside>
          <span aria-hidden="true">+</span>
          <div><h3 data-i18n="events.article.noteTitle">{t.events.article.noteTitle}</h3><p data-i18n="events.article.note">{t.events.article.note}</p></div>
        </aside>
      </section>

      <aside class="event-article__meta" data-reveal>
        <h2 data-i18n="events.article.details">{t.events.article.details}</h2>
        <dl>
          <div><dt data-i18n="events.article.period">{t.events.article.period}</dt><dd>{event.period}</dd></div>
          <div><dt data-i18n="events.article.format">{t.events.article.format}</dt><dd data-i18n="events.article.formatValue">{t.events.article.formatValue}</dd></div>
        </dl>
      </aside>
    </div>

    <nav class="event-article__navigation" aria-label="Navegación entre eventos" data-reveal>
      <a href={`${basePath}eventos/${previousEvent.slug}`}>
        <small data-i18n="events.article.previous">{t.events.article.previous}</small>
        <strong><span aria-hidden="true">←</span> <span data-i18n={`events.items.${previousIndex}.1`}>{t.events.items[previousIndex][1]}</span></strong>
      </a>
      <a href={`${basePath}eventos/${nextEvent.slug}`}>
        <small data-i18n="events.article.next">{t.events.article.next}</small>
        <strong><span data-i18n={`events.items.${nextIndex}.1`}>{t.events.items[nextIndex][1]}</span> <span aria-hidden="true">→</span></strong>
      </a>
    </nav>
  </article>
</BaseLayout>

<style>
  .event-article{--article-teal:#007f98;--article-ink:#101415;--article-soft:#edf2f3;margin:0 auto;max-width:1440px;padding:clamp(7.5rem,12vw,10.5rem) clamp(1rem,4vw,4.5rem) clamp(4rem,8vw,8rem)}
  .event-article__header{display:grid;gap:clamp(2rem,5vw,5rem);grid-template-columns:minmax(170px,.45fr) minmax(0,1.55fr) auto;padding-bottom:clamp(2rem,5vw,4rem)}
  .event-article__back{align-items:center;align-self:start;color:#485254;display:inline-flex;font-size:.88rem;font-weight:680;gap:.7rem;text-decoration:none;width:max-content}.event-article__back>span:first-child{align-items:center;border:1px solid #bac5c7;border-radius:50%;display:inline-flex;height:2.2rem;justify-content:center;width:2.2rem}.event-article__back:focus-visible,.event-article__navigation a:focus-visible{outline:3px solid var(--article-teal);outline-offset:4px}
  .event-article__title p{color:var(--article-teal);font-size:.76rem;font-weight:800;letter-spacing:.13em;margin:0 0 1rem;text-transform:uppercase}.event-article__title h1{color:var(--article-ink);font-size:clamp(3.3rem,7.5vw,7.8rem);font-weight:760;letter-spacing:-.075em;line-height:.82;margin:0;max-width:13ch}.event-article__title strong{color:#4f595b;display:block;font-size:clamp(1.05rem,1.7vw,1.35rem);font-weight:480;line-height:1.5;margin-top:1.8rem;max-width:55ch}
  .event-article__stamp{align-items:center;align-self:start;border:1px solid #bcc6c8;border-radius:50%;display:flex;flex-direction:column;height:8rem;justify-content:center;width:8rem}.event-article__stamp span{color:var(--article-ink);font-size:1.15rem;font-weight:760}.event-article__stamp i{background:var(--article-teal);height:1px;margin:.65rem 0;width:2rem}.event-article__stamp small{color:#687274;font-size:.7rem;font-weight:800;letter-spacing:.16em}
  .event-article__cover{margin:0;position:relative}.event-article__cover img{aspect-ratio:16/8.4;border-radius:0 0 2.2rem 0;display:block;height:auto;object-fit:cover;width:100%}.event-article__cover figcaption{align-items:center;background:#fff;bottom:0;display:flex;gap:2rem;justify-content:space-between;left:0;min-width:min(340px,78%);padding:1rem 1.25rem;position:absolute}.event-article__cover figcaption span{color:#526063;font-size:.78rem;font-weight:700}.event-article__cover figcaption b{color:var(--article-teal)}
  .event-article__content{display:grid;gap:clamp(3rem,8vw,8rem);grid-template-columns:minmax(0,1.45fr) minmax(240px,.55fr);margin:clamp(4rem,9vw,8rem) auto;max-width:1100px}.event-article__story{max-width:720px}.event-article__label{color:var(--article-teal)!important;font-size:.75rem!important;font-weight:800;letter-spacing:.12em;margin:0 0 .9rem!important;text-transform:uppercase}.event-article__story h2{color:var(--article-ink);font-size:clamp(2.3rem,5vw,4.6rem);letter-spacing:-.06em;line-height:.92;margin:0 0 2.2rem}.event-article__story>p{color:#4b5557;font-size:1.08rem;line-height:1.75;margin:0 0 1.4rem}.event-article__story .event-article__lead{color:var(--article-ink);font-size:clamp(1.3rem,2.4vw,1.8rem);font-weight:650;letter-spacing:-.025em;line-height:1.4}.event-article__story>aside{align-items:start;background:var(--article-soft);display:grid;gap:1.2rem;grid-template-columns:auto 1fr;margin-top:2.5rem;padding:1.5rem}.event-article__story>aside>span{color:var(--article-teal);font-size:1.8rem;line-height:1}.event-article__story>aside h3{font-size:1rem;margin:0 0 .45rem}.event-article__story>aside p{color:#5d6769;font-size:.92rem;line-height:1.55;margin:0}
  .event-article__meta{border-top:4px solid var(--article-teal);padding-top:1rem}.event-article__meta h2{font-size:1rem;margin:0 0 1.4rem}.event-article__meta dl{margin:0}.event-article__meta dl>div{border-top:1px solid #ccd3d4;display:grid;gap:.35rem;padding:1rem 0}.event-article__meta dt{color:#748082;font-size:.75rem}.event-article__meta dd{color:var(--article-ink);font-weight:680;margin:0}
  .event-article__navigation{border-top:1px solid #bdc7c9;display:grid;grid-template-columns:1fr 1fr}.event-article__navigation a{color:var(--article-ink);display:grid;gap:.65rem;padding:clamp(1.5rem,4vw,3rem) 0;text-decoration:none}.event-article__navigation a:last-child{border-left:1px solid #bdc7c9;padding-left:clamp(1.5rem,4vw,3rem);text-align:right}.event-article__navigation small{color:#748082;font-size:.75rem}.event-article__navigation strong{font-size:clamp(1rem,2vw,1.35rem)}
  @media (hover:hover){.event-article__back:hover,.event-article__navigation a:hover strong{color:var(--article-teal)}}
  @media (max-width:820px){.event-article__header{grid-template-columns:1fr}.event-article__stamp{display:none}.event-article__content{grid-template-columns:1fr}.event-article__meta{max-width:400px}.event-article__cover img{aspect-ratio:4/3}.event-article__navigation{grid-template-columns:1fr}.event-article__navigation a:last-child{border-left:0;border-top:1px solid #bdc7c9;padding-left:0;text-align:left}}
  @media (max-width:520px){.event-article__title h1{font-size:clamp(3rem,16vw,4.6rem)}.event-article__cover figcaption{min-width:82%}.event-article__content{margin-top:3rem}}
</style>
