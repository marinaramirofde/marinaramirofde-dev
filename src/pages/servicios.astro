---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getDictionary } from "../i18n";
import { portfolioConfig } from "../config/portfolio.config";
import TechIcon from "../components/home/TechIcon.astro";
const t = getDictionary(portfolioConfig.defaultLocale);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const icons = [
  'M12 3v2m7-1-1 2M4 4l2 2m-3 6h2m14 0h2M8 16a6 6 0 1 1 8 0l-1 2H9Zm1 5h6',
  'M4 5h16v14H4Zm0 4h16M8 5v4m2 4-2 2 2 2m4-4 2 2-2 2',
  'M3 8q9-4 18 0v9q-4 3-7-1h-4q-3 4-7 1ZM7 11v3m-1-1h2m8-1h2',
  'm12 3 9 5v9l-9 5-9-5V8Zm0 10 9-5m-9 5L3 8m9 5v9M7 6l10 5',
  'm8 7-5 5 5 5m8-10 5 5-5 5m-3-12-2 18',
  'm9 3 6 0m-5 0v6l-6 9a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-6-9V3M8 15h8m-6 3 2 1 3-3',
  'M12 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm-5 12v-4a5 5 0 0 1 10 0v4M5 5a3 3 0 0 0 0 6m14-6a3 3 0 0 1 0 6M2 20v-4a4 4 0 0 1 3-4m17 8v-4a4 4 0 0 0-3-4',
  'M3 3h18v12H3Zm9 12v6m-5 0 5-4 5 4M7 11l3-3 3 2 4-4'
];
---
<BaseLayout title={`${t.services.title} · ${portfolioConfig.brandName}`} description={t.services.text}>
  <article class="services-page">
    <header class="services-heading"><p class="services-kicker" data-i18n="services.eyebrow">{t.services.eyebrow}</p><h1 data-i18n="services.title">{t.services.title}</h1><p data-i18n="services.text">{t.services.text}</p></header>
    <div class="services-panel"><div class="services-grid">
      {t.services.items.map((title, i) => <section class="service-card" aria-labelledby={`service-${i}`}>
        <div class="service-card__top"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d={icons[i]} /></svg><span class="service-card__number" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span></div>
        <h2 id={`service-${i}`} data-i18n={`services.items.${i}`}>{title}</h2>
        <p data-i18n={`services.descriptions.${i}`}>{t.services.descriptions[i]}</p>
      </section>)}
    </div></div>
    <footer class="services-contact"><p data-i18n="services.contactText">{t.services.contactText}</p><a href={`${base}contacto`}><span data-i18n="services.contact">{t.services.contact}</span><TechIcon kind="chat" /></a></footer>
  </article>
</BaseLayout>
<style>
  .services-page { --services-ink: #363e4f; --services-muted: #535d68; --services-accent: #285e70; max-width: 1380px; margin-inline: auto; padding: clamp(110px, 10vw, 150px) 32px 80px; color: var(--services-ink); font-family: "Manrope", system-ui, sans-serif; }
  .services-heading { max-width: 720px; margin: 0 auto 44px; text-align: center; }
  .services-kicker { color: var(--services-accent); font-size: .85rem; font-weight: 700; margin: 0 0 16px; }
  .services-heading h1 { font-family: inherit; font-size: clamp(2.8rem, 5vw, 4.5rem); line-height: 1.12; letter-spacing: -.05em; margin: 0 0 22px; }
  .services-heading > p:last-child { font-size: 1.05rem; color: var(--services-muted); line-height: 1.8; margin: 0; }
  .services-panel { padding: 24px; border-radius: 24px; background: #edf3f6; }
  .services-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .service-card { min-width: 0; padding: 24px; border: 1px solid #e0e7eb; border-radius: 14px; background: white; box-shadow: 0 4px 16px #243f5005; }
  .service-card__top { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .service-card__top svg { width: 48px; height: 48px; padding: 10px; border-radius: 12px; color: var(--services-accent); background: #e7f1f4; flex-shrink: 0; }
  .service-card:nth-child(3n+2) .service-card__top svg { background: #edf1eb; color: #344c4b; }
  .service-card__number { font-size: .78rem; font-weight: 700; color: #637586; font-variant-numeric: tabular-nums; }
  .service-card h2 { font-family: inherit; font-size: 1.15rem; line-height: 1.45; letter-spacing: -.025em; margin: 0 0 14px; color: var(--services-ink); text-wrap: balance; }
  .service-card p { font-size: .9rem; line-height: 1.8; color: var(--services-muted); margin: 0; }
  .services-contact { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 24px; padding: 36px 24px 0; }
  .services-contact p { margin: 0; max-width: 610px; line-height: 1.7; color: var(--services-muted); }
  .services-contact a { display: inline-flex; align-items: center; justify-content: center; gap: 16px; min-height: 48px; padding: 12px 20px; border-radius: 8px; background: #344c4b; color: white; font-weight: 700; text-decoration: none; }
  .services-contact :global(svg) { width: 24px; height: 24px; flex-shrink: 0; }
  .services-contact a:hover { background: #243f50; }
  .services-contact a:focus-visible { outline: 3px solid var(--services-accent); outline-offset: 5px; }
  @media(max-width: 1120px) { .services-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media(max-width: 600px) { .services-page { padding-inline: 20px; } .services-grid { grid-template-columns: 1fr; gap: 16px; } .services-panel { padding: 16px; border-radius: 18px; } .services-contact { padding-inline: 0; } }
</style>
