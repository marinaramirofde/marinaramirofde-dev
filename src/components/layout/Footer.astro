---
import { portfolioConfig } from "../../config/portfolio.config";
const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const youtubeHref = portfolioConfig.socialLinks.youtube || `${basePath}#youtube`;
const linkedinHref = portfolioConfig.socialLinks.linkedin || `${basePath}#contact`;
const instagramHref = portfolioConfig.socialLinks.instagram || `${basePath}#contact`;
---

<footer class="footer footer--scenic">
  <div class="footer__scenery" aria-hidden="true">
    <span class="footer__sun"></span>
    <span class="footer__sea"></span>
    <span class="footer__shore"></span>
    <span class="footer__mountain footer__mountain--left"></span>
    <span class="footer__mountain footer__mountain--right"></span>
  </div>

  <div class="footer__simple">
    <div class="footer__socials footer__socials--centered" aria-label="Social media">
      <a href={linkedinHref} target="_blank" rel="noreferrer" aria-label="LinkedIn" title="LinkedIn">
        <svg class="footer__linkedin-logo" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45Z" /></svg>
      </a>
      <a href={instagramHref} target="_blank" rel="noreferrer" aria-label="Instagram" title="Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.4" y="3.4" width="17.2" height="17.2" rx="5"/><circle cx="12" cy="12" r="4"/><circle class="footer__social-dot" cx="17.6" cy="6.7" r="1"/></svg>
      </a>
      <a href={youtubeHref} target="_blank" rel="noreferrer" aria-label="YouTube" title="YouTube">
        <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="2.8" y="5.7" width="18.4" height="12.6" rx="4"/><path class="footer__social-fill" d="m10 9 5 3-5 3Z"/></svg>
      </a>
    </div>
    <strong class="footer__simple-name">Marina Ramiro</strong>
  </div>
</footer>
