---
import { portfolioConfig } from "../../config/portfolio.config";
const { t } = Astro.props;
---

<footer class="footer">
  <div class="footer__top">
    <div>
      <p class="eyebrow">{portfolioConfig.handle}</p>
      <p class="footer__role">{portfolioConfig.role}</p>
    </div>
    <a class="footer__availability" href="#contact"><i></i>Open to meaningful projects</a>
  </div>
  <div class="footer__inner">
    <nav aria-label="Footer navigation">
      <a href="#about" data-i18n="nav.about">{t.nav.about}</a>
      <a href="#projects" data-i18n="nav.projects">{t.nav.projects}</a>
      <a href="#research" data-i18n="nav.research">{t.nav.research}</a>
      <a href="#services" data-i18n="footer.services">{t.footer.services}</a>
      <a href="#community" data-i18n="footer.community">{t.footer.community}</a>
      <a href="#contact" data-i18n="nav.contact">{t.nav.contact}</a>
    </nav>
    <div class="footer__links">
      <a href={portfolioConfig.socialLinks.linkedin || "#contact"} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={portfolioConfig.socialLinks.cv || "#contact"} data-i18n="footer.cv">{t.footer.cv}</a>
    </div>
  </div>
  <div class="footer__base">
    <p>&copy; {new Date().getFullYear()} Marina Ramiro. <span data-i18n="footer.copyright">{t.footer.copyright}</span></p>
  </div>
  <strong class="footer__name" aria-hidden="true">MARINA RAMIRO</strong>
</footer>