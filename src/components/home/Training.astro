---
import TechIcon from "./TechIcon.astro";
import Copy from "./Copy.astro";
import type { selectedHomeEs } from "../../i18n/selected-home";
interface Props { t: typeof selectedHomeEs; base: string; }
const { t, base } = Astro.props;
---

<section class="clean-section clean-shell clean-summary" id="training" aria-labelledby="training-title">
  <h2 id="training-title" data-i18n="selectedHome.trainingTitle">{t.trainingTitle}</h2>
  <div class="clean-summary__body"><h3 data-i18n="selectedHome.trainingName">{t.trainingName}</h3><p><Copy value={t.trainingText} path="selectedHome.trainingText" /></p><a class="clean-text-link" href={`${base}formacion-experiencia#certifications-title`}><span data-i18n="selectedHome.moreTraining">{t.moreTraining}</span><TechIcon kind="next" /></a></div>
</section>
