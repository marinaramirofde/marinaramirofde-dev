---
import type { selectedHomeEs } from "../../i18n/selected-home";
interface Props { t: typeof selectedHomeEs; base: string; }
const { t, base } = Astro.props;
const slugs = ["artemisa", "vr-ehabilitar"];
---
<section class="clean-section clean-featured" id="featured-projects" aria-labelledby="featured-title">
  <div class="clean-shell"><header class="clean-featured__heading"><div><h2 id="featured-title" data-i18n="selectedHome.featuredTitle">{t.featuredTitle}</h2><p data-i18n="selectedHome.featuredIntro">{t.featuredIntro}</p></div><a class="clean-button clean-button--secondary" href={`${base}proyectos`}><span data-i18n="selectedHome.projectsCta">{t.projectsCta}</span><span aria-hidden="true">↗</span></a></header>
    <div class="clean-project-grid">{t.featured.map((project, i) => <article class="clean-project"><a class="clean-project__image" href={`${base}proyectos/${slugs[i]}`}><img src={`${base}projects/${slugs[i]}/cover.png`} alt={project.alt} data-i18n-alt={`selectedHome.featured.${i}.alt`} loading="lazy" width="960" height="640" /></a><div class="clean-project__body"><p class="clean-meta" data-i18n={`selectedHome.featured.${i}.category`}>{project.category}</p><h3 data-i18n={`selectedHome.featured.${i}.name`}>{project.name}</h3><p data-i18n={`selectedHome.featured.${i}.description`}>{project.description}</p><a class="clean-text-link" href={`${base}proyectos/${slugs[i]}`}><span data-i18n="selectedHome.projectDetail">{t.projectDetail}</span><span aria-hidden="true">↗</span></a></div></article>)}</div>
  </div>
</section>
