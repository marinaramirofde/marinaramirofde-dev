---
import Copy from "./Copy.astro";
import type { selectedHomeEs } from "../../i18n/selected-home";
interface Props { t: typeof selectedHomeEs; }
const { t } = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---
<section class="clean-section clean-about" id="about" aria-labelledby="about-title">
  <div class="clean-shell clean-about__grid">
    <header><p class="clean-kicker" data-i18n="selectedHome.aboutTitle">{t.aboutTitle}</p><h2 id="about-title" data-i18n="selectedHome.aboutLead">{t.aboutLead}</h2></header>
    <div class="clean-prose">{t.about.map((parts, i) => <p><Copy value={parts} path={`selectedHome.about.${i}`} /></p>)}<p class="clean-belief"><strong data-i18n="selectedHome.belief">{t.belief}</strong></p></div>
    <address id="connect" class="clean-contact"><h3><a class="clean-contact__page" href={`${base}contacto`}><span data-i18n="selectedHome.contactTitle">{t.contactTitle}</span><svg class="clean-contact__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M20 11.5a7.5 7.5 0 0 1-7.5 7.5H5l-3 3V11.5A7.5 7.5 0 0 1 9.5 4H20Z"/><path d="M7 10h8M7 14h5"/></svg></a></h3><a href="mailto:marinaramirofde@gmail.com"><span data-i18n="selectedHome.emailLabel">{t.emailLabel}</span>marinaramirofde@gmail.com</a><a href="tel:+34661195808"><span data-i18n="selectedHome.phoneLabel">{t.phoneLabel}</span>+34 661 195 808</a></address>
  </div>
</section>
