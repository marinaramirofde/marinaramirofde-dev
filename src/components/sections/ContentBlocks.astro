---
import { services } from "../../data/services";
import { skills } from "../../data/skills";
import { galleryItems } from "../../data/gallery";
const { t } = Astro.props;
const projectCards = [
  { title: "XR Medical Viewer", meta: "WebXR · Three.js · Health", code: "XR-01", accent: "blue" },
  { title: "AR Research Prototype", meta: "Unity · C# · Visualization", code: "AR-02", accent: "orange" },
  { title: "Immersive Education Lab", meta: "XR · UX · Community", code: "VR-03", accent: "rose" }
];
---

<section class="section section--soft about" id="about" aria-labelledby="about-title">
  <div class="section__index" aria-hidden="true">02</div>
  <div class="split">
    <div data-reveal>
      <p class="eyebrow">About / Profile</p>
      <h2 id="about-title" data-i18n="about.title">{t.about.title}</h2>
    </div>
    <div class="about__copy" data-reveal>
      <p data-i18n="about.text">{t.about.text}</p>
      <div class="about__facts" aria-label="Professional profile">
        <span>Software engineering</span>
        <span>Extended reality</span>
        <span>Medical visualization</span>
      </div>
      <a class="inline-link" href="/sobre-mi" data-i18n="about.cta">{t.about.cta}<i aria-hidden="true">↗</i></a>
    </div>
  </div>
</section>

<section class="section projects" id="projects" aria-labelledby="projects-title">
  <div class="projects__header" data-reveal>
    <div class="section__index" aria-hidden="true">03</div>
    <div class="section__heading">
      <p class="eyebrow">Selected work / 2024—2026</p>
      <h2 id="projects-title" data-i18n="projects.title">{t.projects.title}</h2>
      <p data-i18n="projects.text">{t.projects.text}</p>
    </div>
  </div>
  <div class="card-grid">
    {projectCards.map((project, index) => (
      <article class={`project-card project-card--${project.accent}`} data-reveal style={`--reveal-delay: ${index * 90}ms`}>
        <a class="project-card__media" href={`/proyectos/${project.title.toLowerCase().replaceAll(" ", "-")}`} aria-label={project.title}>
          <span class="project-card__code">{project.code}</span>
          <span class="project-card__shape" aria-hidden="true"></span>
          <span class="project-card__arrow" aria-hidden="true">↗</span>
        </a>
        <div class="project-card__body">
          <p>{project.meta}</p>
          <h3>{project.title}</h3>
        </div>
      </article>
    ))}
  </div>
  <a class="button button--primary projects__cta" href="/proyectos" data-i18n="projects.cta">{t.projects.cta}</a>
</section>

<section class="section section--dark research" id="research" aria-labelledby="research-title">
  <div class="section__index" aria-hidden="true">04</div>
  <div class="research__grid">
    <div data-reveal>
      <p class="eyebrow">Research / Health tech</p>
      <h2 id="research-title" data-i18n="research.title">{t.research.title}</h2>
    </div>
    <div class="research__copy" data-reveal>
      <p data-i18n="research.text">{t.research.text}</p>
      <div class="research__diagram" aria-hidden="true">
        <span>DATA</span><i></i><span>3D</span><i></i><span>XR</span>
      </div>
    </div>
  </div>
</section>

<section class="section section--soft events" id="events" aria-labelledby="events-title">
  <div class="events__header" data-reveal>
    <div class="section__index" aria-hidden="true">05</div>
    <div class="section__heading">
      <p class="eyebrow">Agenda / Community</p>
      <h2 id="events-title" data-i18n="events.title">{t.events.title}</h2>
      <p data-i18n="events.text">{t.events.text}</p>
    </div>
  </div>
  <div class="timeline">
    <article class="timeline__row" data-reveal>
      <span>2026</span><strong>XR, health and innovation events</strong><i aria-hidden="true">Upcoming</i>
    </article>
    <article class="timeline__row" data-reveal>
      <span>Archive</span><strong>Professional meetings & community</strong><i aria-hidden="true">Explore ↗</i>
    </article>
  </div>
</section>

<section class="section talks" id="talks" aria-labelledby="talks-title">
  <div class="section__index" aria-hidden="true">06</div>
  <div class="talks__layout">
    <div data-reveal>
      <p class="eyebrow">Talks / Knowledge</p>
      <h2 id="talks-title" data-i18n="talks.title">{t.talks.title}</h2>
    </div>
    <blockquote data-reveal>
      <span aria-hidden="true">“</span>
      <p data-i18n="talks.text">{t.talks.text}</p>
    </blockquote>
  </div>
</section>

<section class="section section--dark services" id="services" aria-labelledby="services-title">
  <div class="services__header" data-reveal>
    <div class="section__index" aria-hidden="true">07</div>
    <div class="section__heading">
      <p class="eyebrow">Services / Collaboration</p>
      <h2 id="services-title" data-i18n="services.title">{t.services.title}</h2>
      <p data-i18n="services.text">{t.services.text}</p>
    </div>
  </div>
  <div class="service-list">
    {services.map((service, index) => (
      <div class="service-item" data-reveal style={`--reveal-delay: ${index * 50}ms`}>
        <span>0{index + 1}</span><strong>{service}</strong><i aria-hidden="true">↗</i>
      </div>
    ))}
  </div>
</section>

<section class="section section--soft skills" id="skills" aria-labelledby="skills-title">
  <div class="skills__header" data-reveal>
    <div class="section__index" aria-hidden="true">08</div>
    <div class="section__heading">
      <p class="eyebrow">Stack / Toolkit</p>
      <h2 id="skills-title" data-i18n="skills.title">{t.skills.title}</h2>
    </div>
  </div>
  <div class="tag-cloud" data-reveal>
    {skills.map((skill, index) => <span><b>0{index + 1}</b>{skill}</span>)}
  </div>
</section>

<section class="section gallery" id="gallery" aria-labelledby="gallery-title">
  <div class="gallery__header" data-reveal>
    <div class="section__index" aria-hidden="true">09</div>
    <div class="section__heading">
      <p class="eyebrow">Media / Process</p>
      <h2 id="gallery-title" data-i18n="gallery.title">{t.gallery.title}</h2>
      <p data-i18n="gallery.text">{t.gallery.text}</p>
    </div>
  </div>
  <div class="gallery__grid">
    {galleryItems.map((item, index) => (
      <figure class={`gallery-item gallery-item--${item.accent}`} data-reveal style={`--reveal-delay: ${index * 80}ms`}>
        <div class="gallery-item__visual" aria-hidden="true"><span>0{index + 1}</span><i></i></div>
        <figcaption><strong>{item.title}</strong><span>{item.type}</span></figcaption>
      </figure>
    ))}
  </div>
</section>