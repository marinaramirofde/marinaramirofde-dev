---
import { technologies } from "../../data/technologies";
const { t } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
---

<section class="section section--soft technologies" id="technologies" aria-labelledby="technologies-title">
  <header class="technologies__header">
    <p class="eyebrow" data-i18n="technologies.eyebrow">{t.technologies.eyebrow}</p>
    <h2 id="technologies-title" data-i18n="technologies.title">{t.technologies.title}</h2>
    <p data-i18n="technologies.text">{t.technologies.text}</p>
  </header>
  <div class="technology-grid technology-grid--logos">
    {technologies.map((item) => (
      <article
        class={`technology-card technology-card--logo${item.format ? ` technology-card--${item.format}` : ""}`}
        aria-label={item.name}
        tabindex="0"
        title={item.name}
      >
        <img
          src={`${basePath}${item.logo.replace(/^\/+/, "")}`}
          alt=""
          loading="lazy"
          decoding="async"
        />
        <span class="technology-card__name">{item.name}</span>
      </article>
    ))}
  </div>
</section>
