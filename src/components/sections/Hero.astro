---
const { t } = Astro.props;
---

<section class="hero section hero--interactive" id="hero" aria-labelledby="hero-title">
  <div class="hero__stage hero__stage--headset" data-reveal data-headset-hero aria-label="Interactive XR headset preview">
    <canvas class="hero-headset" data-headset-canvas></canvas>
    <div class="hero-headset__fallback" aria-hidden="true">
      <span class="hero-headset__body"></span>
      <span class="hero-headset__strap hero-headset__strap--left"></span>
      <span class="hero-headset__strap hero-headset__strap--right"></span>
      <span class="hero-headset__lens hero-headset__lens--left"></span>
      <span class="hero-headset__lens hero-headset__lens--right"></span>
    </div>
    <div class="hero-headset__hotspots" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span></span>
    </div>
    <div class="hero__name">
      <h1 id="hero-title" data-i18n="hero.title">{t.hero.title}</h1>
    </div>
  </div>

  <div class="hero__intro" data-reveal>
    <p class="hero__role" data-i18n="hero.role">{t.hero.role}</p>
    <p class="hero__text" data-i18n="hero.text">{t.hero.text}</p>
    <div class="hero__actions">
      <a class="button button--primary" href="#projects" data-i18n="hero.projects">{t.hero.projects}</a>
      <a class="button button--ghost" href="#contact" data-cv-link data-i18n="hero.cv">{t.hero.cv}</a>
      <a class="button button--plain" href="#contact" data-i18n="hero.contact">{t.hero.contact}</a>
    </div>
    <div class="hero__meta" aria-label="Areas of expertise">
      <span><i></i>XR / VR / AR</span>
      <span data-i18n="hero.health">{t.hero.health}</span>
      <span data-i18n="hero.location">{t.hero.location}</span>
    </div>
  </div>
</section>

<script>
  import { initHeroHeadset } from "../../scripts/heroHeadset";
  initHeroHeadset();
</script>
