---
import { portfolioConfig } from "../../config/portfolio.config";
import { socialItems } from "../../data/social";
const { t } = Astro.props;
const action = portfolioConfig.form.endpoint || "#";
const socialMarks: Record<string, string> = {
  instagram: "IG",
  youtube: "YT",
  linkedin: "in",
  github: "GH",
  email: "@",
  whatsapp: "WA"
};
---

<section class="section section--dark contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__intro" data-reveal>
    <p class="eyebrow">Contact / Let's talk</p>
    <h2 id="contact-title" data-i18n="contact.title">{t.contact.title}</h2>
    <p data-i18n="contact.text">{t.contact.text}</p>
    <div class="contact__socials" aria-label="Social links">
      {socialItems.map((item) => (
        <a href={item.href || "#"} aria-disabled={!item.href}>
          <span class={`social-mark social-mark--${item.id}`} aria-hidden="true">{socialMarks[item.id]}</span>
          <span>{item.label}</span>
        </a>
      ))}
    </div>
  </div>
  <form class="contact-form" action={action} method="post" data-reveal>
    <div class="contact-form__header">
      <span>01</span>
      <p data-i18n="contact.text">{t.contact.text}</p>
    </div>
    <div class="contact-form__row">
      <label>
        <span data-i18n="contact.name">{t.contact.name}</span>
        <input type="text" name="name" autocomplete="name" required />
      </label>
      <label>
        <span data-i18n="contact.email">{t.contact.email}</span>
        <input type="email" name="email" autocomplete="email" required />
      </label>
    </div>
    <label>
      <span data-i18n="contact.subject">{t.contact.subject}</span>
      <input type="text" name="subject" required />
    </label>
    <label>
      <span data-i18n="contact.message">{t.contact.message}</span>
      <textarea name="message" rows="5" required></textarea>
    </label>
    <label class="checkbox">
      <input type="checkbox" name="consent" required />
      <span data-i18n="contact.consent">{t.contact.consent}</span>
    </label>
    <div class="contact-form__footer">
      <button class="button button--primary" type="submit" data-i18n="contact.submit">{t.contact.submit}</button>
      {!portfolioConfig.form.endpoint && <p class="form-note" data-i18n="contact.note">{t.contact.note}</p>}
    </div>
  </form>
</section>