---
import { portfolioConfig } from "../../config/portfolio.config";
import { socialItems } from "../../data/social";
const { t } = Astro.props;
const action = portfolioConfig.form.endpoint || "#";
---

<section class="section section--dark contact" id="contact" aria-labelledby="contact-title">
  <div class="contact__intro" data-reveal>
    <p class="eyebrow" data-i18n="contact.eyebrow">{t.contact.eyebrow}</p>
    <h2 id="contact-title" data-i18n="contact.title">{t.contact.title}</h2>
    <p data-i18n="contact.text">{t.contact.text}</p>
    <div class="contact__socials" aria-label="Social links">
      {socialItems.map((item) => (
        <a href={item.href || "#contact"} target={item.href && !item.href.startsWith("mailto:") ? "_blank" : undefined} rel={item.href && !item.href.startsWith("mailto:") ? "noreferrer" : undefined}>
          <span class={`social-mark social-mark--${item.id}`} aria-hidden="true">
            {item.id === "instagram" && <svg viewBox="0 0 24 24"><rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.4" cy="6.8" r="1" class="icon-fill"></circle></svg>}
            {item.id === "youtube" && <svg viewBox="0 0 24 24"><rect x="2.5" y="5.5" width="19" height="13" rx="4"></rect><path d="m10 9 5 3-5 3Z" class="icon-fill"></path></svg>}
            {item.id === "linkedin" && <svg viewBox="0 0 24 24"><path d="M6.5 8.5H3.5V20h3V8.5Zm.2-3.6A1.7 1.7 0 1 0 3.3 5a1.7 1.7 0 0 0 3.4 0ZM9 8.5h2.9v1.6h.1c.4-.8 1.4-2 3.5-2 3.7 0 4.4 2.4 4.4 5.6V20h-3v-5.6c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1V20H9V8.5Z" class="icon-fill"></path></svg>}
            {item.id === "github" && <svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 0 0-2.8 17.6c.5.1.7-.2.7-.5v-1.7c-2.8.6-3.4-1.2-3.4-1.2-.5-1.2-1.1-1.5-1.1-1.5-.9-.6.1-.6.1-.6 1 0 1.6 1.1 1.6 1.1.9 1.6 2.4 1.1 2.9.8.1-.7.4-1.1.7-1.4-2.2-.3-4.6-1.1-4.6-5A3.9 3.9 0 0 1 7.2 8c-.1-.3-.5-1.3.1-2.7 0 0 .9-.3 3 1.1a10.3 10.3 0 0 1 5.4 0c2.1-1.4 3-1.1 3-1.1.6 1.4.2 2.4.1 2.7a3.9 3.9 0 0 1 1.1 2.7c0 3.9-2.4 4.7-4.6 5 .4.3.7.9.7 1.8v2.6c0 .3.2.6.7.5A9 9 0 0 0 12 3Z" class="icon-fill"></path></svg>}
            {item.id === "email" && <svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="2"></rect><path d="m4 7 8 6 8-6"></path></svg>}
            {item.id === "whatsapp" && <svg viewBox="0 0 24 24"><path d="M20 11.7a8 8 0 0 1-11.8 7l-4.2 1 1.1-4A8 8 0 1 1 20 11.7Z"></path><path d="M8.5 7.7c.3-.3.7-.2.9.2l.8 1.8c.1.3 0 .6-.2.8l-.6.6c.7 1.4 1.8 2.5 3.2 3.2l.7-.8c.2-.2.5-.3.8-.1l1.7.8c.4.2.5.6.3.9-.5.8-1.3 1.3-2.2 1.3-3.7-.3-6.7-3.2-7-6.9 0-.7.6-1.4 1.6-1.8Z"></path></svg>}
          </span>
          <span>{item.label}</span>
        </a>
      ))}
    </div>
  </div>
  <form class="contact-form" action={action} method="post" data-reveal>
    <div class="contact-form__header"><span>01</span><p data-i18n="contact.text">{t.contact.text}</p></div>
    <div class="contact-form__row">
      <label><span data-i18n="contact.name">{t.contact.name}</span><input type="text" name="name" autocomplete="name" required /></label>
      <label><span data-i18n="contact.email">{t.contact.email}</span><input type="email" name="email" autocomplete="email" required /></label>
    </div>
    <label><span data-i18n="contact.subject">{t.contact.subject}</span><input type="text" name="subject" required /></label>
    <label><span data-i18n="contact.message">{t.contact.message}</span><textarea name="message" rows="5" required></textarea></label>
    <label class="checkbox"><input type="checkbox" name="consent" required /><span data-i18n="contact.consent">{t.contact.consent}</span></label>
    <div class="contact-form__footer">
      <button class="button button--primary" type="submit" data-i18n="contact.submit">{t.contact.submit}</button>
      {!portfolioConfig.form.endpoint && <p class="form-note" data-i18n="contact.note">{t.contact.note}</p>}
    </div>
  </form>
</section>