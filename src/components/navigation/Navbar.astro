---
import { portfolioConfig } from "../../config/portfolio.config";
const { t } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const navItems = [
  ["about", `${basePath}#about`, t.nav.about], ["projects", `${basePath}#projects`, t.nav.projects],
  ["research", `${basePath}#research`, t.nav.research], ["events", `${basePath}#events`, t.nav.events],
  ["talks", `${basePath}#talks`, t.nav.talks], ["youtube", `${basePath}#youtube`, t.nav.youtube],
  ["services", `${basePath}#services`, t.nav.services], ["recommendations", `${basePath}#recomendados`, t.nav.recommendations], ["faq", `${basePath}#faq`, t.nav.faq],
  ["contact", `${basePath}#contact`, t.nav.contact]
];
const linkedinHref = portfolioConfig.socialLinks.linkedin || `${basePath}#contact`;
---

<header class="site-header" data-site-header>
  <nav class="navbar" aria-label="Primary navigation">
    <a class="brand" href={basePath} aria-label="Marina Ramiro Fernández home">
      <span class="brand__mark" aria-hidden="true">MRF</span>
      <span>Marina Ramiro Fernández</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label={t.nav.menu} data-nav-toggle data-open-label={t.nav.menu} data-close-label={t.nav.close}>
      <span></span><span></span><span></span>
    </button>
    <div class="nav-menu" id="nav-menu" data-nav-menu>
      {navItems.map(([id, href, label]) => <a href={href} data-section-link={id} data-i18n={`nav.${id}`}>{label}</a>)}
      <div class="language-switcher" aria-label="Language selector">
        <button type="button" class="is-active" data-lang-choice="es" aria-pressed="true"><img class="language-switcher__flag" src={`${basePath}flag-es.svg`} alt="" loading="lazy" decoding="async" /><span>ES</span></button>
        <span class="language-switcher__divider" aria-hidden="true">|</span>
        <button type="button" data-lang-choice="en" aria-pressed="false"><img class="language-switcher__flag" src={`${basePath}flag-gb.svg`} alt="" loading="lazy" decoding="async" /><span>EN</span></button>
      </div>
      <div class="contact-icons" aria-label="Contact links">
        <span class="contact-icons__divider" aria-hidden="true"></span>
        <a class="contact-icon contact-icon--linkedin" href={linkedinHref} target="_blank" rel="noreferrer" aria-label={t.nav.linkedin} data-i18n-aria="nav.linkedin" title="LinkedIn"><span aria-hidden="true">in</span></a>
      </div>
    </div>
  </nav>
</header>