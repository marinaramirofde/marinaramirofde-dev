---
import { portfolioConfig } from "../../config/portfolio.config";
const { t } = Astro.props;
const basePath = import.meta.env.BASE_URL.endsWith("/") ? import.meta.env.BASE_URL : `${import.meta.env.BASE_URL}/`;
const primaryItems = [
  ["home", basePath, t.nav.home],
  ["about", `${basePath}sobre-mi`, t.nav.about],
  ["projects", `${basePath}proyectos`, t.nav.projects],
  ["services", `${basePath}servicios`, t.nav.services]
];
const contentItems = [
  ["youtube", `${basePath}contenido#youtube`, t.nav.youtube],
  ["gallery", `${basePath}contenido#gallery`, t.nav.gallery],
  ["events", `${basePath}contenido#events`, t.nav.events],
  ["recomendados", `${basePath}contenido#recomendados`, t.nav.recommendations]
];
const contactItems = [
  ["community", `${basePath}contacto#community`, t.nav.community],
  ["contact", `${basePath}contacto#contact`, t.nav.form]
];
const linkedinHref = portfolioConfig.socialLinks.linkedin || `${basePath}#contact`;
---

<header class="site-header" data-site-header>
  <nav class="navbar" aria-label="Primary navigation">
    <a class="brand" href={basePath} aria-label="Marina Ramiro Fernández home">
      <span class="brand__mark" aria-hidden="true">MRF</span>
      <span>Marina Ramiro Fernández</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-menu" aria-label={t.nav.menu} data-nav-toggle data-open-label={t.nav.menu} data-close-label={t.nav.close}>
      <span></span><span></span><span></span>
    </button>
    <div class="nav-menu" id="nav-menu" data-nav-menu>
      {primaryItems.map(([id, href, label], index) => (
        <>
          {index > 0 && <span class="nav-separator" aria-hidden="true">·</span>}
          <a class="nav-link" href={href} data-section-link={id} data-i18n={`nav.${id}`}>{label}</a>
        </>
      ))}
      <span class="nav-separator" aria-hidden="true">·</span>
      <div class="nav-dropdown" data-nav-dropdown>
        <button class="nav-dropdown__toggle" type="button" aria-expanded="false" data-nav-dropdown-toggle>
          <span data-i18n="nav.content">{t.nav.content}</span>
          <span class="nav-dropdown__chevron" aria-hidden="true">
            <svg viewBox="0 0 16 16" focusable="false"><path d="m3.25 5.75 4.75 4.5 4.75-4.5" /></svg>
          </span>
        </button>
        <div class="nav-dropdown__menu">
          {contentItems.map(([id, href, label]) => (
            <a href={href} data-section-link={id} data-i18n={`nav.${id === "recomendados" ? "recommendations" : id}`}>{label}</a>
          ))}
        </div>
      </div>
      <span class="nav-separator" aria-hidden="true">·</span>
      <div class="nav-dropdown" data-nav-dropdown>
        <button class="nav-dropdown__toggle" type="button" aria-expanded="false" data-nav-dropdown-toggle>
          <span data-i18n="nav.contact">{t.nav.contact}</span>
          <span class="nav-dropdown__chevron" aria-hidden="true">
            <svg viewBox="0 0 16 16" focusable="false"><path d="m3.25 5.75 4.75 4.5 4.75-4.5" /></svg>
          </span>
        </button>
        <div class="nav-dropdown__menu nav-dropdown__menu--right">
          {contactItems.map(([id, href, label]) => (
            <a href={href} data-section-link={id} data-i18n={`nav.${id === "contact" ? "form" : id}`}>{label}</a>
          ))}
        </div>
      </div>
      <span class="nav-separator" aria-hidden="true">·</span>
      <div class="language-switcher" aria-label="Language selector">
        <button type="button" class="is-active" data-lang-choice="es" aria-pressed="true"><span>ES</span></button>
        <span class="language-switcher__divider" aria-hidden="true">|</span>
        <button type="button" data-lang-choice="en" aria-pressed="false"><span>EN</span></button>
      </div>
      <span class="nav-separator" aria-hidden="true">·</span>
      <div class="contact-icons" aria-label="Contact links">
        <a class="contact-icon contact-icon--linkedin" href={linkedinHref} target="_blank" rel="noreferrer" aria-label={t.nav.linkedin} data-i18n-aria="nav.linkedin" title="LinkedIn"><span aria-hidden="true">in</span></a>
      </div>
    </div>
  </nav>
</header>
